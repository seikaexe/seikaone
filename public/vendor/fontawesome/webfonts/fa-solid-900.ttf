<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <script>
    (function () {
      try {
        var sp = new URLSearchParams(window.location.search);
        var qTheme = sp.get('theme');
        if (qTheme === 'classic') {
          localStorage.setItem('zyro_theme_engine', 'classic');
        } else if (qTheme === 'cream') {
          localStorage.setItem('zyro_theme_engine', 'cream');
        }
        var engine = localStorage.getItem('zyro_theme_engine') || localStorage.getItem('zyro_theme') || 'cream';
        if (engine === 'light') engine = 'cream';
        window._themeEngine = engine;

        var d = document.documentElement;
        if (engine === 'classic' || engine === 'dark') {
          d.setAttribute('data-theme', 'dark');
          d.classList.add('dark');
          d.classList.remove('cream');
          d.style.backgroundColor = '#070e1b';
          d.style.colorScheme = 'dark';
        } else {
          d.setAttribute('data-theme', 'cream');
          d.classList.remove('dark');
          d.classList.add('cream');
          d.style.backgroundColor = '#FAF8F5';
          d.style.colorScheme = 'light';
        }
      } catch (_) {}
    })();
  </script>
