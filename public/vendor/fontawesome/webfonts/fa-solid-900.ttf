  <script>
    /* ====================================================
       EARLY ZERO-FLICKER AUTH & PRELOADER CONTROLLER
       Executes synchronously in <head> before DOM paint
       ==================================================== */
    (function () {
      try {
        var token = localStorage.getItem('zyro_user_token') || localStorage.getItem('user_token') || sessionStorage.getItem('zyro_user_token');
        var rawUser = localStorage.getItem('zyro_user_data');
        if (token && rawUser) {
          window.__EARLY_USER__ = JSON.parse(rawUser);
          var u = window.__EARLY_USER__;
          var cachedAva = localStorage.getItem('zyro_cached_avatar_b64');
          window.__EARLY_AVA__ = cachedAva || (u && u.avatar) || '/assets/logo.webp';
          window.__EARLY_NAME__ = (u && u.name) ? (u.name.split(' ')[0] || u.name) : 'Member';
          window.__EARLY_EMAIL__ = (u && u.email) || '';
          
          var isOwner = Boolean(u && (
            (u.email && ['gilangx288@gmail.com', 'zyrodevv@gmail.com', 'gilram336@gmail.com'].includes(u.email.toLowerCase())) ||
            (u.isAdmin === true && u.cpanelRole?.category === 'owner')
          ));
          window.__EARLY_IS_OWNER__ = isOwner;

          var role = ((u && u.cpanelRole?.name) || (u && u.role) || 'Member').replace('Legal ', '');
          if (u && Array.isArray(u.roles)) {
            if (u.roles.includes('bug_hunter')) role = '<i class="fa-solid fa-bug"></i> Bug Hunter';
            else if (u.roles.includes('top_leaderboard')) role = '<i class="fa-solid fa-trophy"></i> Top Leaderboard';
            else if (isOwner || u.roles.includes('developer') || u.roles.includes('founder')) role = '<i class="fa-solid fa-crown"></i> Founder / Dev';
          } else if (isOwner) {
            role = '<i class="fa-solid fa-crown"></i> Founder / Dev';
          }
          window.__EARLY_ROLE__ = role;

          if (window.__EARLY_USER__ && window.__EARLY_USER__.avatar) {
            try {
              var earlyImg = new Image();
              earlyImg.decoding = 'sync';
              earlyImg.src = window.__EARLY_AVA__;
            } catch (_) {}
          }
          document.documentElement.classList.add('zyro-authenticated');
          document.documentElement.classList.remove('zyro-guest');
          var isHidden = localStorage.getItem('zyro_hide_balance') === 'true' || localStorage.getItem('zyro_balance_hidden') === 'true';
          var balNum = Number(u.balance || 0);
          var bStr = isHidden ? 'Rp ••••••••' : ('Rp ' + balNum.toLocaleString('id-ID'));
          window.__EARLY_BAL_STR__ = bStr;
          if (!isHidden && typeof u.balance !== 'undefined') {
            if (bStr.length > 15) {
              document.documentElement.classList.add('zyro-bal-huge');
            } else if (bStr.length > 12) {
              document.documentElement.classList.add('zyro-bal-long');
            }
          }
        } else {
          document.documentElement.classList.add('zyro-guest');
          document.documentElement.classList.remove('zyro-authenticated');
        }
      } catch(e) {
        document.documentElement.classList.add('zyro-guest');
      }

      // Early Sync Store Stats from Cache (Zero FOUS)
      try {
        var cachedUsers = localStorage.getItem('zyro_total_users');
        if (cachedUsers && !window.currentStoreTotalUsers) {
          var cu = parseInt(cachedUsers, 10);
          if (!isNaN(cu) && cu > 0) window.currentStoreTotalUsers = cu;
        }
        var cachedTrx = localStorage.getItem('zyro_total_trx');
        if (cachedTrx && !window.currentStoreTotalTrx) {
          var ct = parseInt(cachedTrx, 10);
          if (!isNaN(ct) && ct > 0) window.currentStoreTotalTrx = ct;
        }
      } catch(_) {}

      // Record page start time for luxury tech entrance preloader
      window.__PAGE_START__ = Date.now();

      window.handleLockedMenu = function() {
        return true;
      };
    })();
  </script>
  <script>
    (function () {
      var sp = new URLSearchParams(window.location.search);
      var qTheme = sp.get('theme');
      if (qTheme === 'classic') {
        localStorage.setItem('zyro_theme_engine', 'classic');
      } else if (qTheme === 'cream') {
        localStorage.setItem('zyro_theme_engine', 'cream');
      }
      var engine = localStorage.getItem('zyro_theme_engine') || localStorage.getItem('zyro_theme') || 'cream';
      if (engine === 'light') engine = 'cream';
      window._themeEngine = engine;

      var isDark = (engine === 'classic' || engine === 'dark' || localStorage.getItem('zyro_theme') === 'dark');
      if (isDark) {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('cream');
        var link = document.getElementById('themeEngineStylesheet');
        if (link && engine === 'classic') link.disabled = true;
      } else {
        document.documentElement.setAttribute('data-theme', 'cream');
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('cream');
      }
    })();

    window.toggleThemeEngine = function() {
      var cur = localStorage.getItem('zyro_theme_engine') || 'cream';
      var next = (cur === 'cream') ? 'classic' : 'cream';
      localStorage.setItem('zyro_theme_engine', next);
      window.location.reload();
    };
  </script>
  <script src="/js/lib/utils.js?v=2.1" defer></script>
  <script>
    function applyStoreTheme(theme) {
      var isDark = theme === 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      if (isDark) {
        document.documentElement.classList.add('dark');
        if (document.body) document.body.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
        if (document.body) document.body.classList.remove('dark');
      }
      document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      document.documentElement.style.removeProperty('background-color');
      document.documentElement.style.removeProperty('color');
      var actualTheme = isDark ? 'dark' : 'cream';
      document.documentElement.setAttribute('data-theme', actualTheme);
      localStorage.setItem('zyro_theme', actualTheme);
      if (typeof window !== 'undefined') window.isDark = isDark;
      var icons = document.querySelectorAll('#themeBtn i, #sidebarThemeIcon, .theme-toggle-icon');
      icons.forEach(function (ic) {
        var isSpinning = ic.classList.contains('cp-theme-spin');
        ic.className = (isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon') + (isSpinning ? ' cp-theme-spin' : '');
      });
    }

    function toggleTheme() {
      var cur = localStorage.getItem('zyro_theme') || document.documentElement.getAttribute('data-theme') || (document.body && document.body.classList.contains('dark') ? 'dark' : 'cream');
      var tgt = cur === 'dark' ? 'cream' : 'dark';

      // 1. Icon spin animation feedback without layout thrashing
      var icons = document.querySelectorAll('#themeBtn i, #sidebarThemeIcon, .theme-toggle-icon');
      icons.forEach(function (ic) {
        ic.classList.remove('cp-theme-spin');
      });
      requestAnimationFrame(function () {
        icons.forEach(function (ic) {
          ic.classList.add('cp-theme-spin');
        });
      });

      var executeTheme = function () {
        applyStoreTheme(tgt);
      };

      if (window.smoothThemeTransition) {
        window.smoothThemeTransition(executeTheme);
      } else if (document.startViewTransition) {
        document.startViewTransition(executeTheme);
      } else {
        executeTheme();
      }
    }

    (function initTheme() {
      var saved = localStorage.getItem('zyro_theme') || 'cream';
      applyStoreTheme(saved);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { applyStoreTheme(saved); });
      }
    })();
  </script>
  <style>
    /* ====================================================
       CRITICAL ZERO-FLICKER AUTH & PRELOADER RULES
       ==================================================== */
    html.zyro-authenticated #home-balance-card {
      display: flex !important;
    }
    html.zyro-authenticated #home-guest-balance-card {
      display: none !important;
    }
    html.zyro-authenticated #btnTopLogin {
      display: none !important;
    }
    html.zyro-authenticated #userNavPill {
      display: inline-flex !important;
    }

    html.zyro-guest #home-balance-card {
      display: none !important;
    }
    html.zyro-guest #home-guest-balance-card {
      display: flex !important;
    }
    html.zyro-guest #btnTopLogin {
      display: inline-flex !important;
    }
    html.zyro-guest #userNavPill {
      display: none !important;
    }

    :root[data-theme="dark"], html.dark {
      color-scheme: dark;
    }
    :root[data-theme="light"], :root[data-theme="cream"], html:not(.dark) {
      color-scheme: light;
    }
    *, *::before, *::after {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent !important;
    }
    html, body {
      background-color: var(--bg, #070e1b);
      color: var(--t1, #f1f5f9);
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      -webkit-tap-highlight-color: transparent !important;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }

    /* VIEW TRANSITIONS API SUPPORT (Silky smooth 60/120fps GPU theme cross-fade) */
    ::view-transition-image-pair(root) {
      isolation: isolate;
    }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.28s;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    ::view-transition-new(root) {
      mix-blend-mode: normal;
    }

    /* SILKY SMOOTH THEME TRANSITION (Universal Fallback) */
    html.theme-transitioning,
    html.theme-transitioning *,
    html.theme-transitioning *::before,
    html.theme-transitioning *::after,
    html.cp-theme-transitioning,
    html.cp-theme-transitioning *,
    html.cp-theme-transitioning *::before,
    html.cp-theme-transitioning *::after {
      transition: background-color 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                  border-color 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                  color 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                  box-shadow 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                  fill 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                  stroke 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
      transition-delay: 0s !important;
    }

    .cp-theme-spin {
      animation: cpThemeSpin 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }
    @keyframes cpThemeSpin {
      0% {
        transform: rotate(0deg) scale(0.65);
        opacity: 0.3;
      }
      50% {
        transform: rotate(180deg) scale(1.22);
        opacity: 0.85;
      }
      100% {
        transform: rotate(360deg) scale(1);
        opacity: 1;
      }
    }
    .notif-permission-card {
      display: none;
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(40px);
      width: calc(100% - 32px);
      max-width: 440px;
      background: rgba(15, 23, 42, 0.96);
      border: 1.5px solid rgba(14, 165, 233, 0.35);
      border-radius: 20px;
      padding: 16px 18px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75), 0 0 35px rgba(14, 165, 233, 0.2);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      z-index: 999999;
      opacity: 0;
      pointer-events: none;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      box-sizing: border-box;
      font-family: inherit;
    }
    .notif-permission-card.active-ready {
      display: block !important;
    }
    .notif-permission-card.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .npc-body { display: flex; flex-direction: column; gap: 10px; }
    .npc-top { display: flex; align-items: center; gap: 12px; }
    .npc-icon-box {
      width: 42px; height: 42px; border-radius: 14px;
      background: rgba(14, 165, 233, 0.12);
      border: 1px solid rgba(14, 165, 233, 0.3);
      color: #38bdf8; display: flex; align-items: center; justify-content: center;
      font-size: 1.15rem; flex-shrink: 0; position: relative;
    }
    .npc-pulse {
      position: absolute; top: -2px; right: -2px; width: 10px; height: 10px;
      border-radius: 50%; background: #f43f5e;
      animation: notifPulse 1.6s infinite;
    }
    @keyframes notifPulse {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(244, 63, 94, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
    }
    .npc-head-info { flex: 1; min-width: 0; }
    .npc-title {
      font-size: 0.92rem; font-weight: 800; color: #fff;
      letter-spacing: -0.2px; display: flex; align-items: center; gap: 6px;
    }
    .npc-sub { font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
    .npc-btn-dismiss {
      width: 28px; height: 28px; border-radius: 8px;
      background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
      color: #94a3b8; cursor: pointer; display: flex; align-items: center; justify-content: center;
      font-size: 0.85rem; transition: all 0.2s ease; flex-shrink: 0;
    }
    .npc-btn-dismiss:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }
    .npc-text { font-size: 0.76rem; color: #94a3b8; line-height: 1.45; margin: 0; }
    .npc-text b { color: #38bdf8; }
    .npc-actions { display: flex; align-items: center; gap: 10px; margin-top: 4px; }
    .npc-btn-allow {
      flex: 1; background: #0284c7;
      color: #fff; border: 1px solid #0284c7; padding: 10px 16px; border-radius: 12px;
      font-size: 0.82rem; font-weight: 700; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 2px 8px rgba(2, 132, 199, 0.25); transition: all 0.2s ease; font-family: inherit;
    }
    .npc-btn-allow:hover { filter: brightness(1.12); transform: translateY(-1px); }
    .npc-btn-later {
      background: rgba(255, 255, 255, 0.05); color: #94a3b8;
      border: 1px solid rgba(255, 255, 255, 0.1); padding: 10px 14px; border-radius: 12px;
      font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;
      font-family: inherit; white-space: nowrap;
    }
    .npc-btn-later:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
    @media (max-width: 580px) {
      .notif-permission-card { bottom: 16px; width: calc(100% - 24px); padding: 14px 16px; }
    }
  </style>
  <!-- ONESIGNAL WEB SDK -->
  <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
  <script>
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    OneSignalDeferred.push(async function(OneSignal) {
      try {
        await OneSignal.init({
          appId: "e939fe32-d119-43a6-99cb-b0493b5dba0b",
          serviceWorkerParam: { scope: "/" },
          serviceWorkerPath: "/OneSignalSDKWorker.js",
          notifyButton: { enable: false }
        });
        if (OneSignal.Notifications && OneSignal.Notifications.permission) {
          const btn = document.getElementById('btn-subscribe-push');
          const label = document.getElementById('pushBtnLabel');
          if (btn) btn.classList.add('active');
          if (label) label.textContent = 'Aktif';
        }
      } catch (err) {
        console.warn('[OneSignal Init Warn]:', err);
      }
    });
  </script>
  <!-- GOOGLE IDENTITY SERVICES (Only for unauthenticated guests) -->
  <script>
    (function() {
      try {
        var token = localStorage.getItem('zyro_user_token') || localStorage.getItem('user_token') || sessionStorage.getItem('zyro_user_token');
        if (!token) {
          var gs = document.createElement('script');
          gs.src = 'https://accounts.google.com/gsi/client';
          gs.async = true;
          gs.defer = true;
          document.head.appendChild(gs);
        }
      } catch(e) {}
    })();
  </script>
