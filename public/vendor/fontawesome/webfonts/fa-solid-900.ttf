<!-- KLAIM GARANSI MODAL -->
<div class="modal-ov" id="warrantyModal">
  <div class="modal-sheet">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-shield-halved" style="color:#38bdf8;"></i> Pusat Klaim Garansi Panel</div>
        <div class="modal-head-sub">Garansi 30 Hari: Ganti server / Reinstall / Perbaikan</div>
      </div>
      <button class="modal-close-btn" onclick="closeWarrantyModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="warr-wrap">
      <div class="warr-tab-nav">
        <button class="warr-tab-btn act" id="tab-claim-btn" onclick="switchWarrantyTab('claim')">
          <i class="fa-solid fa-file-shield"></i> Ajukan Klaim
        </button>
        <button class="warr-tab-btn" id="tab-status-btn" onclick="switchWarrantyTab('status')">
          <i class="fa-solid fa-magnifying-glass"></i> Cek Status Tiket
        </button>
      </div>

      <!-- TAB 1: FORM AJUKAN KLAIM -->
      <div id="warr-form-tab">
        <form onsubmit="submitWarrantyClaim(event)">
          <div class="warr-field">
            <label class="warr-lbl">Kode Garansi / Order ID <span style="color:var(--rose);">*</span></label>
            <input type="text" id="warrCodeInput" class="warr-in" placeholder="Contoh: WARR-ZYRO-XXXXXX atau ORD-XXXX" required>
            <small style="font-size:0.68rem;color:var(--t3);margin-top:3px;display:block;">Bisa cek di bukti pesanan, halaman sukses bayar, atau cek invoice email.</small>
          </div>
          <div class="warr-field">
            <label class="warr-lbl">Email Akun Pembeli</label>
            <input type="email" id="warrEmailInput" class="warr-in" placeholder="email@contoh.com">
          </div>
          <div class="warr-field">
            <label class="warr-lbl">No WhatsApp / Telegram Pembeli</label>
            <input type="text" id="warrContactInput" class="warr-in" placeholder="08xxxxxxxxxx atau @username">
          </div>
          <div class="warr-field">
            <label class="warr-lbl">Jenis Kendala <span style="color:var(--rose);">*</span></label>
            <select id="warrIssueType" class="warr-in" required>
              <option value="down">Server Down / Panel Error / Can't Start</option>
              <option value="reinstall">Minta Reinstall Egg / Ganti Node / Ganti Versi</option>
              <option value="reset_pass">Lupa Akun / Reset Password Panel Pterodactyl</option>
              <option value="node_issue">Kendala Node / Disk Penuh / Out of Memory</option>
              <option value="other">Kendala Teknis Lainnya</option>
            </select>
          </div>
          <div class="warr-field">
            <label class="warr-lbl">Deskripsi Kendala <span style="color:var(--rose);">*</span></label>
            <textarea id="warrDescInput" class="warr-in" placeholder="Jelaskan kendala yang dialami secara singkat dan jelas..." required></textarea>
          </div>
          <button type="submit" id="btnSubmitClaim" class="btn-order" style="margin-top:14px;">
            <i class="fa-solid fa-paper-plane"></i> Kirim Pengajuan Garansi
          </button>
        </form>
      </div>

      <!-- TAB 2: CEK STATUS TIKET -->
      <div id="warr-status-tab" style="display:none;">
        <div class="warr-field">
          <label class="warr-lbl">Masukkan Nomor Tiket / Kode Garansi / Order ID</label>
          <div style="display:flex;gap:8px;">
            <input type="text" id="warrSearchInput" class="warr-in" placeholder="TICKET-XXXXXX atau WARR-XXXXXX">
            <button type="button" onclick="checkWarrantyTicketStatus()" class="btn-act btn-save" style="margin:0;padding:0 16px;white-space:nowrap;border-radius:10px;">
              <i class="fa-solid fa-magnifying-glass"></i> Cek
            </button>
          </div>
        </div>
        <div id="warrStatusResult" style="margin-top:16px;"></div>
      </div>
    </div>
  </div>
</div>

<!-- AUTH MODAL (LOGIN / REGISTER / GOOGLE SIGN-IN) -->
<div class="modal-ov" id="authModal">
  <div class="modal-sheet" style="max-width:440px;">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-circle-user" style="color:var(--a);"></i> <span id="authModalHeadTitle">Masuk ke Akun</span></div>
        <div class="modal-head-sub" id="authModalHeadSub">Dapatkan potongan otomatis 5% setiap transaksi</div>
      </div>
      <button class="modal-close-btn" onclick="closeAuthModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div style="padding:18px 22px 26px;">
      <!-- Google Sign In Button -->
      <button type="button" class="btn-google-auth" id="btnGoogleLogin" onclick="triggerGoogleSignIn()">
        <svg class="google-logo-svg" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Masuk Cepat dengan Google</span>
      </button>

      <!-- Google GIS Target Container (if client id rendered) -->
      <div id="googleBtnContainer" style="display:none;margin-bottom:12px;"></div>

      <div class="auth-divider">ATAU DENGAN EMAIL</div>

      <!-- Auth Tabs: Login vs Register -->
      <div class="warr-tab-nav" style="margin-bottom:16px;">
        <button type="button" class="warr-tab-btn act" id="tab-login-btn" onclick="switchAuthTab('login')">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Masuk
        </button>
        <button type="button" class="warr-tab-btn" id="tab-register-btn" onclick="switchAuthTab('register')">
          <i class="fa-solid fa-user-plus"></i> Daftar (Diskon 5%)
        </button>
      </div>

      <!-- FORM LOGIN -->
      <form id="formAuthLogin" onsubmit="handleUserLogin(event)">
        <div class="warr-field">
          <label class="warr-lbl">Email Akun</label>
          <input type="email" id="loginEmail" class="warr-in" placeholder="email@contoh.com" required>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Password</label>
          <input type="password" id="loginPass" class="warr-in" placeholder="••••••••" required>
        </div>
        <button type="submit" id="btnLoginSubmit" class="btn-order" style="margin-top:10px;">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Masuk Sekarang
        </button>
      </form>

      <!-- FORM REGISTER -->
      <form id="formAuthRegister" onsubmit="handleUserRegister(event)" style="display:none;">
        <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:12px;padding:10px 12px;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
          <i class="fa-solid fa-gift" style="color:#22c55e;font-size:1.1rem;"></i>
          <span style="font-size:0.75rem;color:var(--t1);font-weight:600;">Daftar gratis & nikmati <b>Diskon Otomatis 5%</b> untuk setiap order!</span>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Nama Lengkap</label>
          <input type="text" id="regName" class="warr-in" placeholder="Nama Anda" required>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Email</label>
          <input type="email" id="regEmail" class="warr-in" placeholder="email@contoh.com" required>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">No. WhatsApp / Telegram</label>
          <input type="text" id="regPhone" class="warr-in" placeholder="08xxxxxxxxxx atau @username">
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Password Baru</label>
          <input type="password" id="regPass" class="warr-in" placeholder="Minimal 6 karakter" required minlength="6">
        </div>
        <button type="submit" id="btnRegisterSubmit" class="btn-order" style="margin-top:10px;background:#22c55e;">
          <i class="fa-solid fa-crown"></i> Buat Akun & Dapatkan Diskon 5%
        </button>
      </form>
    </div>
  </div>
</div>

<!-- USER ORDERS HISTORY MODAL (SEMUA PESANAN & PANEL SAYA) -->
<div class="modal-ov" id="userOrdersModal">
  <div class="modal-sheet" style="max-width:620px;">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-receipt" style="color:var(--a);"></i> <span id="ordersModalTitle">Riwayat Pesanan</span></div>
        <div class="modal-head-sub" id="userOrdersSub">Daftar transaksi Anda (Member maupun Guest / Tanpa Login)</div>
      </div>
      <button class="modal-close-btn" onclick="closeUserOrdersModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <!-- TABS: ALL ORDERS vs PANEL SAYA -->
    <div style="padding:10px 20px 0;display:flex;gap:8px;">
      <button type="button" class="warr-tab-btn act" id="tabBtnAllOrders" onclick="switchOrderModalTab('all')">
        <i class="fa-solid fa-bag-shopping"></i> Semua Pesanan
      </button>
      <button type="button" class="warr-tab-btn" id="tabBtnMyPanels" onclick="switchOrderModalTab('panel')">
        <i class="fa-solid fa-server" style="color:#10b981;"></i> Panel Saya
      </button>
    </div>

    <!-- SEARCH / LOOKUP BAR FOR GUEST & MEMBER -->
    <div style="padding:12px 20px 0;" id="orderLookupWrap">
      <div style="display:flex;gap:8px;">
        <input type="text" id="orderSearchInput" class="warr-in" placeholder="Ketik Email atau Order ID (misal ZYRO-123456)..." style="font-size:0.8rem;padding:9px 14px;" onkeydown="if(event.key==='Enter') executeOrderSearch()">
        <button type="button" class="btn-order" onclick="executeOrderSearch()" style="width:auto;padding:0 16px;white-space:nowrap;font-size:0.8rem;">
          <i class="fa-solid fa-magnifying-glass"></i> Cari
        </button>
      </div>
      <div id="guestOrderPrompt" style="display:none;margin-top:8px;font-size:0.73rem;color:var(--t3);line-height:1.4;">
        <i class="fa-solid fa-circle-info" style="color:var(--a);"></i> <span>Ingin pesanan tersimpan otomatis tanpa perlu cari email? <a href="/login" style="color:var(--a);font-weight:700;">Masuk / Daftar Akun Member (Diskon 5%)</a></span>
      </div>
    </div>

    <div style="padding:14px 20px 24px;max-height:65vh;overflow-y:auto;" id="userOrdersList">
      <div style="padding:30px;text-align:center;color:var(--t3);"><i class="fa-solid fa-spinner fa-spin"></i> Memuat riwayat pesanan...</div>
    </div>
  </div>
</div>

<!-- ACCOUNT SETTINGS MODAL (GANTI PROFIL, EMAIL, PASSWORD) -->
<div class="modal-ov" id="accountSettingsModal">
  <div class="modal-sheet" style="max-width:480px;">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-user-gear" style="color:#06b6d4;"></i> <span>Pengaturan Akun</span></div>
        <div class="modal-head-sub">Kelola data profil, email, dan kata sandi akun Anda</div>
      </div>
      <button class="modal-close-btn" onclick="closeAccountSettingsModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <!-- USER SUMMARY CARD -->
    <div style="padding:14px 20px 0;">
      <div style="background:var(--bg2);border:1px solid var(--b1);border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:12px;">
        <div style="position:relative;flex-shrink:0;">
          <img src="/assets/logo.webp" id="settUserAvatar" width="48" height="48" alt="Avatar" style="width:48px;height:48px;border-radius:50%;border:2px solid var(--a);object-fit:cover;display:block;">
          <button type="button" onclick="document.getElementById('settAvatarFileInput').click()" title="Ganti Foto Profil" style="position:absolute;bottom:-2px;right:-2px;width:22px;height:22px;border-radius:50%;background:var(--a);color:#fff;border:1.5px solid var(--surface);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:0.6rem;padding:0;">
            <i class="fa-solid fa-camera"></i>
          </button>
        </div>
        <div style="overflow:hidden;flex:1;">
          <div id="settUserName" style="font-size:0.9rem;font-weight:800;color:var(--t1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Member Zyro</div>
          <div id="settUserEmail" style="font-size:0.75rem;color:var(--t3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="503d353d323522103528313d203c357e333f3d">[email&#160;protected]</a></div>
          <div style="font-size:0.68rem;color:#22c55e;font-weight:700;margin-top:2px;"><i class="fa-solid fa-crown" style="color:#f59e0b;"></i> Diskon Member 5% Aktif</div>
        </div>
      </div>
      <input type="file" id="settAvatarFileInput" accept="image/*,image/png,image/jpeg,image/webp,image/gif" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;opacity:0;" onchange="handleSettingsAvatarUpload(event)">
    </div>

    <!-- TABS -->
    <div style="padding:14px 20px 0;display:flex;gap:6px;">
      <button type="button" class="warr-tab-btn act" id="settTabBtnProfile" onclick="switchSettingsTab('profile')">
        <i class="fa-solid fa-id-card"></i> Profil
      </button>
      <button type="button" class="warr-tab-btn" id="settTabBtnEmail" onclick="switchSettingsTab('email')">
        <i class="fa-solid fa-envelope"></i> Ganti Email
      </button>
      <button type="button" class="warr-tab-btn" id="settTabBtnPassword" onclick="switchSettingsTab('password')">
        <i class="fa-solid fa-key"></i> Ganti Password
      </button>
    </div>

    <div style="padding:16px 20px 24px;">
      <!-- TAB 1: EDIT PROFILE -->
      <form id="formSettProfile" onsubmit="handleUpdateProfile(event)">
        <div class="warr-field">
          <label class="warr-lbl">Nama Lengkap</label>
          <input type="text" id="settInputName" class="warr-in" placeholder="Nama Anda" required>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">No. WhatsApp / Username Telegram</label>
          <input type="text" id="settInputPhone" class="warr-in" placeholder="08xxxxxxxxxx atau @username">
        </div>
        <button type="submit" id="btnSettProfileSubmit" class="btn-order" style="margin-top:8px;">
          <i class="fa-solid fa-floppy-disk"></i> Simpan Profil
        </button>
      </form>

      <!-- TAB 2: CHANGE EMAIL -->
      <form id="formSettEmail" onsubmit="handleUpdateEmail(event)" style="display:none;">
        <div class="warr-field">
          <label class="warr-lbl">Email Saat Ini</label>
          <input type="email" id="settInputCurrentEmail" class="warr-in" style="opacity:0.7;" disabled readonly>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Alamat Email Baru</label>
          <input type="email" id="settInputNewEmail" class="warr-in" placeholder="emailbaru@contoh.com" required>
        </div>
        <div class="warr-field" id="settEmailPassField">
          <label class="warr-lbl">Password Akun (Konfirmasi Keamanan)</label>
          <input type="password" id="settInputEmailPassword" class="warr-in" placeholder="Masukkan password Anda">
        </div>
        <button type="submit" id="btnSettEmailSubmit" class="btn-order" style="margin-top:8px;background:#0ea5e9;">
          <i class="fa-solid fa-envelope-circle-check"></i> Perbarui Email
        </button>
      </form>

      <!-- TAB 3: CHANGE PASSWORD -->
      <form id="formSettPassword" onsubmit="handleUpdatePassword(event)" style="display:none;">
        <div class="warr-field" id="settOldPassField">
          <label class="warr-lbl">Password Lama</label>
          <input type="password" id="settInputOldPass" class="warr-in" placeholder="••••••••">
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Password Baru (Min. 6 Karakter)</label>
          <input type="password" id="settInputNewPass" class="warr-in" placeholder="Password baru" minlength="6" required>
        </div>
        <div class="warr-field">
          <label class="warr-lbl">Konfirmasi Password Baru</label>
          <input type="password" id="settInputConfirmPass" class="warr-in" placeholder="Ulangi password baru" minlength="6" required>
        </div>
        <button type="submit" id="btnSettPassSubmit" class="btn-order" style="margin-top:8px;background:#10b981;">
          <i class="fa-solid fa-lock"></i> Perbarui Password
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ADD-ON SPEK PANEL INFO MODAL -->
<div class="modal-ov" id="addonInfoModal">
  <div class="modal-sheet" style="max-width:580px;">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-microchip" style="color:#0ea5e9;"></i> Add-On Spek Panel Pterodactyl</div>
        <div class="modal-head-sub">Tingkatkan spesifikasi server panel Anda secara instan</div>
      </div>
      <button class="modal-close-btn" onclick="closeAddonInfoModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div style="padding:16px 20px 24px;max-height:75vh;overflow-y:auto;">
      <!-- Add-on Feature Highlights -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:18px;">
        <div style="background:var(--bg2);border:1px solid var(--b1);border-radius:12px;padding:12px;text-align:center;">
          <div style="width:36px;height:36px;border-radius:10px;background:rgba(14,165,233,0.15);color:#0ea5e9;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:1.1rem;">
            <i class="fa-solid fa-memory"></i>
          </div>
          <b style="font-size:0.82rem;color:var(--t1);display:block;">Tambah RAM</b>
          <span style="font-size:0.72rem;color:var(--t3);">Mulai Rp 1.000 / GB<br>Pilihan +1GB s/d +4GB</span>
        </div>
        <div style="background:var(--bg2);border:1px solid var(--b1);border-radius:12px;padding:12px;text-align:center;">
          <div style="width:36px;height:36px;border-radius:10px;background:rgba(168,85,247,0.15);color:#a855f7;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:1.1rem;">
            <i class="fa-solid fa-hard-drive"></i>
          </div>
          <b style="font-size:0.82rem;color:var(--t1);display:block;">Tambah NVMe Disk</b>
          <span style="font-size:0.72rem;color:var(--t3);">Mulai Rp 500 / GB<br>Pilihan +2GB s/d +10GB</span>
        </div>
        <div style="background:var(--bg2);border:1px solid var(--b1);border-radius:12px;padding:12px;text-align:center;">
          <div style="width:36px;height:36px;border-radius:10px;background:rgba(234,179,8,0.15);color:#eab308;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:1.1rem;">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <b style="font-size:0.82rem;color:var(--t1);display:block;">Tambah CPU Power</b>
          <span style="font-size:0.72rem;color:var(--t3);">Mulai Rp 1.000 / 25%<br>Maksimal Server 250%</span>
        </div>
      </div>

      <!-- Pricing Table per Tier -->
      <div style="background:var(--surface);border:1px solid var(--b1);border-radius:14px;padding:14px;margin-bottom:16px;">
        <div style="font-size:0.78rem;font-weight:800;color:var(--t1);margin-bottom:10px;display:flex;align-items:center;gap:7px;">
          <i class="fa-solid fa-table-list" style="color:var(--a);"></i> Tarif Add-on per Kategori Panel
        </div>
        <div style="overflow-x:auto;">
          <table style="width:100%;font-size:0.75rem;border-collapse:collapse;text-align:left;">
            <thead>
              <tr style="border-bottom:1px solid var(--b1);color:var(--t3);">
                <th style="padding:6px 8px;">Kategori Panel</th>
                <th style="padding:6px 8px;">RAM / GB</th>
                <th style="padding:6px 8px;">Disk / GB</th>
                <th style="padding:6px 8px;">CPU / 25%</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom:1px solid var(--b1);">
                <td style="padding:8px 8px;font-weight:700;">Legal Publik</td>
                <td style="padding:8px 8px;color:#0ea5e9;">+Rp 1.000</td>
                <td style="padding:8px 8px;color:#a855f7;">+Rp 500</td>
                <td style="padding:8px 8px;color:#eab308;">+Rp 1.000</td>
              </tr>
              <tr style="border-bottom:1px solid var(--b1);">
                <td style="padding:8px 8px;font-weight:700;">Legal Private</td>
                <td style="padding:8px 8px;color:#0ea5e9;">+Rp 1.500</td>
                <td style="padding:8px 8px;color:#a855f7;">+Rp 750</td>
                <td style="padding:8px 8px;color:#eab308;">+Rp 1.500</td>
              </tr>
              <tr style="border-bottom:1px solid var(--b1);">
                <td style="padding:8px 8px;font-weight:700;">Legal Enterprise</td>
                <td style="padding:8px 8px;color:#0ea5e9;">+Rp 2.000</td>
                <td style="padding:8px 8px;color:#a855f7;">+Rp 1.000</td>
                <td style="padding:8px 8px;color:#eab308;">+Rp 2.000</td>
              </tr>
              <tr>
                <td style="padding:8px 8px;font-weight:700;">Legal Premium</td>
                <td style="padding:8px 8px;color:#0ea5e9;">+Rp 2.500</td>
                <td style="padding:8px 8px;color:#a855f7;">+Rp 1.250</td>
                <td style="padding:8px 8px;color:#eab308;">+Rp 2.500</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Max CPU Rule Explanation -->
      <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:12px;padding:12px 14px;margin-bottom:18px;font-size:0.75rem;line-height:1.45;color:var(--t1);">
        <i class="fa-solid fa-shield-halved" style="color:#f59e0b;margin-right:4px;"></i>
        <b>Aturan Batas CPU 250%:</b> Sesuai kebijakan stabilitas node server ZyroStore, total batas CPU maksimal dibatasi pada <b>250%</b>. Jika paket panel yang dibeli sudah memiliki CPU 250% (seperti paket Unlimited / 10GB), penambahan CPU tidak lagi dapat dipilih agar server terhindar dari overload.
      </div>

      <!-- Action Button -->
      <button class="btn-order" onclick="closeAddonInfoModal(); scrollToPanelCatalog();" style="width:100%;padding:14px;font-size:0.88rem;">
        <i class="fa-solid fa-server"></i> Pilih Panel & Pasang Add-On Sekarang
      </button>
    </div>
  </div>
</div>

<!-- TOP UP SALDO MODAL -->
<div class="modal-ov" id="topupModal">
  <div class="modal-sheet" style="max-width: 480px;">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-wallet" style="color:var(--a);"></i> <span>Isi Saldo Akun</span></div>
        <div class="modal-head-sub">Top up via QRIS Otomatis (BCA, Mandiri, Dana, GoPay, OVO, dll)</div>
      </div>
      <button class="modal-close-btn" onclick="closeTopupModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <!-- BODY WRAPPER -->
    <div style="padding: 18px 22px 24px;">

      <!-- STEP 1: PILIH NOMINAL -->
      <div id="topup-step-input">
        <!-- CURRENT BALANCE INFO -->
        <div class="topup-current-box">
          <div style="font-size:0.75rem; color:var(--t3); display:flex; align-items:center; gap:6px;">
            <i class="fa-solid fa-coins" style="color:#f59e0b;"></i> Saldo Anda Saat Ini
          </div>
          <div class="topup-current-val" id="topup-modal-current-bal">Rp 0</div>
        </div>

        <!-- QUICK NOMINAL CHIPS -->
        <label style="font-size:0.82rem; font-weight:700; color:var(--t1); margin-bottom:8px; display:block;">
          Pilih Nominal Instan:
        </label>
        <div class="topup-chips-grid">
          <button type="button" class="topup-chip" data-nominal="5000" onclick="selectTopupChip(5000, this)">Rp 5.000</button>
          <button type="button" class="topup-chip" data-nominal="10000" onclick="selectTopupChip(10000, this)">Rp 10.000</button>
          <button type="button" class="topup-chip act" data-nominal="20000" onclick="selectTopupChip(20000, this)">Rp 20.000</button>
          <button type="button" class="topup-chip" data-nominal="50000" onclick="selectTopupChip(50000, this)">Rp 50.000</button>
          <button type="button" class="topup-chip" data-nominal="100000" onclick="selectTopupChip(100000, this)">Rp 100.000</button>
          <button type="button" class="topup-chip" data-nominal="200000" onclick="selectTopupChip(200000, this)">Rp 200.000</button>
        </div>

        <!-- CUSTOM INPUT -->
        <div style="margin-top:14px;">
          <label style="font-size:0.82rem; font-weight:700; color:var(--t1); margin-bottom:6px; display:block;">
            Atau Ketik Nominal Lain (Min. Rp 1.000):
          </label>
          <div class="topup-input-wrap">
            <span class="topup-input-prefix">Rp</span>
            <input type="number" id="topup-input-custom" placeholder="20.000" min="1000" step="1000" value="20000" oninput="onTopupCustomInput(this)">
          </div>
        </div>

        <!-- SUMMARY CALCULATION -->
        <div class="topup-summary-box">
          <div class="topup-summary-row">
            <span>Nominal Top Up</span>
            <b id="topup-sum-amount">Rp 20.000</b>
          </div>
          <div class="topup-summary-row">
            <span>Biaya Layanan / Admin</span>
            <span style="color:#10b981; font-weight:700;"><i class="fa-solid fa-gift"></i> Rp 0 (GRATIS)</span>
          </div>
          <div class="topup-summary-row topup-summary-total">
            <span>Total Pembayaran QRIS</span>
            <b id="topup-sum-total" style="color:var(--a);">Rp 20.000</b>
          </div>
        </div>

        <button type="button" class="btn-topup-action" id="btn-topup-generate" onclick="submitTopupOrder()">
          <i class="fa-solid fa-qrcode"></i> Lanjut Bayar QRIS Otomatis
        </button>

        <!-- OWNER DIRECT SALDO INJECTION (KHUSUS DEVELOPER/FOUNDER) -->
        <div id="topup-owner-direct-box" style="display:none; margin-top:16px; padding:12px 14px; border-radius:14px; background:var(--surface); border:1px dashed rgba(245, 158, 11, 0.4);">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
            <div style="font-size:0.78rem; font-weight:800; color:#fbbf24; display:flex; align-items:center; gap:6px;">
              <i class="fa-solid fa-bolt"></i> Bypass Top Up (Khusus Owner / Developer)
            </div>
            <span style="font-size:0.65rem; background:rgba(245, 158, 11, 0.2); color:#f59e0b; padding:2px 8px; border-radius:999px; font-weight:700;">INSTAN</span>
          </div>
          <p style="font-size:0.73rem; color:var(--t2); margin:0 0 10px; line-height:1.4;">
            Sebagai Owner / Developer, Anda dapat langsung menambahkan nominal di atas ke saldo akun Anda tanpa scan QRIS.
          </p>
          <button type="button" id="btn-owner-instant-topup" class="btn-owner-instant" onclick="submitOwnerSelfTopup()">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Tambah Saldo Instan ke Akun Sendiri
          </button>
        </div>
      </div>

      <!-- STEP 2: QRIS PAYMENT SCREEN -->
      <div id="topup-step-qris" style="display:none; text-align:center;">
        <div class="topup-qris-status-badge">
          <i class="fa-solid fa-clock fa-spin"></i> MENUNGGU PEMBAYARAN
        </div>

        <div class="topup-qris-total-box">
          <div style="font-size:0.75rem; color:var(--t3);">Total yang Harus Dibayar:</div>
          <div class="topup-qris-total-val" id="topup-qris-total-val">Rp 20.000</div>
          <div style="font-size:0.72rem; color:var(--t2); margin-top:2px;">
            ID Transaksi: <b id="topup-qris-id">-</b>
          </div>
        </div>

        <div class="topup-qr-img-wrap">
          <img id="topup-qr-img" src="" alt="QRIS Top Up">
        </div>

        <div class="topup-timer-text">
          Selesaikan pembayaran dalam <b id="topup-timer-val" style="color:#ef4444;">15:00</b>
        </div>

        <div style="font-size:0.75rem; color:var(--t3); line-height:1.45; margin-bottom:14px;">
          Buka aplikasi m-Banking atau E-Wallet (BCA, Mandiri, Dana, GoPay, OVO, ShopeePay, dll) lalu scan QRIS di atas. Saldo otomatis masuk setelah pembayaran sukses!
        </div>

        <div style="display:flex; gap:10px;">
          <button type="button" class="topup-btn-dl" onclick="downloadTopupQris()">
            <i class="fa-solid fa-download"></i> Unduh QR
          </button>
          <button type="button" class="topup-btn-check" id="btn-topup-manual-check" onclick="manualCheckTopupStatus()">
            <i class="fa-solid fa-rotate-right"></i> Cek Status
          </button>
        </div>

        <button type="button" class="topup-btn-cancel" onclick="cancelTopupTransaction()">
          <i class="fa-solid fa-xmark"></i> Batalkan Top Up
        </button>
      </div>

      <!-- STEP 3: SUCCESS SCREEN -->
      <div id="topup-step-success" style="display:none; text-align:center; padding:16px 0;">
        <div class="topup-success-icon">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h4 style="font-weight:800; color:var(--t1); margin-bottom:6px; font-size:1.2rem;">Top Up Berhasil!</h4>
        <p style="font-size:0.8rem; color:var(--t2); line-height:1.45; margin-bottom:16px;">
          Pembayaran Anda telah terverifikasi. Saldo berhasil ditambahkan ke akun Anda secara instan.
        </p>

        <div class="topup-success-box">
          <div class="topup-summary-row">
            <span>Nominal Ditambahkan</span>
            <b id="topup-success-amount" style="color:#10b981;">+Rp 20.000</b>
          </div>
          <div class="topup-summary-row topup-summary-total">
            <span>Saldo Baru Anda</span>
            <b id="topup-success-newbal" style="color:var(--a); font-size:1.15rem;">Rp 20.000</b>
          </div>
        </div>

        <button type="button" class="btn-topup-action" onclick="finishTopupSuccess()">
          <i class="fa-solid fa-check"></i> Selesai & Mulai Belanja
        </button>
      </div>

    </div>
  </div>
</div>

<!-- OWNER REWARD & ADD SALDO MODAL (EXCLUSIVE FOR FOUNDER / DEVELOPER) -->
<div class="modal-ov" id="ownerRewardModal">
  <div class="modal-sheet" style="max-width: 520px;">
    <div class="mhandle"></div>
    <div class="modal-head-bar">
      <div>
        <div class="modal-head-title"><i class="fa-solid fa-crown" style="color:#fbbf24;"></i> <span>Reward & Add Saldo</span></div>
        <div class="modal-head-sub">Khusus Owner & Developer: Kirim reward saldo / role ke buyer</div>
      </div>
      <button class="modal-close-btn" onclick="closeOwnerRewardModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div style="padding: 18px 22px 24px; max-height: 80vh; overflow-y: auto;">
      <!-- TARGET SELECTION TABS -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-bottom:16px;">
        <button type="button" id="tab-home-tgt-buyer" class="topup-chip act" onclick="setHomeRewardTarget('buyer')" style="padding:10px; font-weight:700;">
          <i class="fa-solid fa-gift"></i> Kirim ke Buyer
        </button>
        <button type="button" id="tab-home-tgt-self" class="topup-chip" onclick="setHomeRewardTarget('self')" style="padding:10px; font-weight:700;">
          <i class="fa-solid fa-user-shield"></i> Saldo Sendiri
        </button>
      </div>

      <!-- FORM FIELDS -->
      <form id="homeRewardForm" onsubmit="submitHomeOwnerReward(event)">
        <!-- TARGET BUYER SEARCH -->
        <div id="home-reward-buyer-group" style="margin-bottom:14px; position:relative;">
          <label style="font-size:0.8rem; font-weight:700; color:var(--t1); margin-bottom:6px; display:block;">
            Cari User / Buyer Penerima:
          </label>
          <div class="topup-input-wrap">
            <span class="topup-input-prefix"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="home-reward-user-search" placeholder="Ketik Email, Username, atau ID User..." autocomplete="off" oninput="onHomeRewardSearch(this.value)">
          </div>
          <div id="home-reward-user-results" style="display:none; position:absolute; left:0; right:0; top:100%; background:var(--surface); border:1px solid var(--b1); border-radius:12px; max-height:190px; overflow-y:auto; z-index:1000; box-shadow:0 12px 30px rgba(0,0,0,0.45); margin-top:4px;"></div>
          <div id="home-reward-selected-box" style="display:none; margin-top:8px; padding:10px 12px; border-radius:10px; background:rgba(14, 165, 233, 0.08); border:1px solid rgba(14, 165, 233, 0.3); align-items:center; justify-content:space-between;">
            <div>
              <div style="font-weight:700; font-size:0.83rem; color:var(--t1);" id="home-reward-sel-name">-</div>
              <div style="font-size:0.73rem; color:var(--t2);" id="home-reward-sel-detail">-</div>
            </div>
            <button type="button" onclick="clearHomeRewardSelectedUser()" style="background:transparent; border:none; color:var(--t3); cursor:pointer; font-size:0.85rem;"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <input type="hidden" id="home-reward-target-id" value="">
        </div>

        <!-- NOMINAL REWARD -->
        <div style="margin-bottom:14px;">
          <label style="font-size:0.8rem; font-weight:700; color:var(--t1); margin-bottom:6px; display:block;">
            Nominal Saldo (Rp):
          </label>
          <div class="topup-chips-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom:8px;">
            <button type="button" class="topup-chip" onclick="setHomeRewardNominal(10000, this)">Rp 10.000</button>
            <button type="button" class="topup-chip" onclick="setHomeRewardNominal(25000, this)">Rp 25.000</button>
            <button type="button" class="topup-chip act" onclick="setHomeRewardNominal(50000, this)">Rp 50.000</button>
            <button type="button" class="topup-chip" onclick="setHomeRewardNominal(100000, this)">Rp 100.000</button>
            <button type="button" class="topup-chip" onclick="setHomeRewardNominal(250000, this)">Rp 250.000</button>
            <button type="button" class="topup-chip" onclick="setHomeRewardNominal(500000, this)">Rp 500.000</button>
          </div>
          <div class="topup-input-wrap">
            <span class="topup-input-prefix">Rp</span>
            <input type="number" id="home-reward-amount" min="1000" step="1000" value="50000" required>
          </div>
        </div>

        <!-- CATEGORY DROPDOWN -->
        <div style="margin-bottom:14px;">
          <label style="font-size:0.8rem; font-weight:700; color:var(--t1); margin-bottom:6px; display:block;">
            Kategori Reward / Pemberian:
          </label>
          <select id="home-reward-category" style="width:100%; padding:10px 12px; border-radius:10px; background:var(--bg2); border:1px solid var(--b1); color:var(--t1); font-size:0.85rem; font-family:inherit;" onchange="onHomeRewardCategoryChange(this.value)">
            <option value="bug">Bug Bounty / Penemu Bug Web</option>
            <option value="leaderboard">Top Leaderboard / Top Transaksi</option>
            <option value="kompensasi">Kompensasi Kendala Sistem</option>
            <option value="event">Event / Giveaway Komunitas</option>
            <option value="self">Top Up Saldo Sendiri (Owner Instan)</option>
            <option value="lain-lain">Penyesuaian Saldo / Bonus Lain</option>
          </select>
        </div>

        <!-- ATTACH ROLE OPTION -->
        <div id="home-reward-role-group" style="margin-bottom:14px; padding:12px; background:var(--bg2); border:1px solid var(--b1); border-radius:10px;">
          <label style="font-size:0.8rem; font-weight:700; color:var(--t1); margin-bottom:8px; display:block;">
            <i class="fa-solid fa-id-badge" style="color:var(--a);"></i> Sematkan Gelar / Role Khusus:
          </label>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <label style="display:flex; align-items:center; gap:8px; font-size:0.78rem; color:var(--t2); cursor:pointer;">
              <input type="radio" name="home_assign_role" value="" checked>
              <span>Tidak mengubah role buyer</span>
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.78rem; color:var(--t2); cursor:pointer;">
              <input type="radio" name="home_assign_role" value="bug_hunter" id="home-role-bughunter">
              <span><b style="color:#10b981;"><i class="fa-solid fa-bug"></i> Bug Hunter</b> (Penemu bug keamanan / fitur)</span>
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.78rem; color:var(--t2); cursor:pointer;">
              <input type="radio" name="home_assign_role" value="top_leaderboard" id="home-role-leaderboard">
              <span><b style="color:#f59e0b;"><i class="fa-solid fa-trophy"></i> Top Leaderboard</b> (Juara transaksi terbanyak)</span>
            </label>
          </div>
        </div>

        <!-- NOTES -->
        <div style="margin-bottom:18px;">
          <label style="font-size:0.8rem; font-weight:700; color:var(--t1); margin-bottom:6px; display:block;">
            Catatan / Alasan (Opsional):
          </label>
          <input type="text" id="home-reward-note" placeholder="Contoh: Hadiah pelaporan bug checkout cart" style="width:100%; padding:10px 12px; border-radius:10px; background:var(--bg2); border:1px solid var(--b1); color:var(--t1); font-size:0.83rem; box-sizing:border-box;">
        </div>

        <!-- SUBMIT BUTTON -->
        <button type="submit" id="btn-submit-home-reward" class="btn-owner-instant" style="font-size:0.9rem; padding:12px;">
          <i class="fa-solid fa-paper-plane"></i> Proses & Kirim Saldo Reward
        </button>
      </form>
    </div>
  </div>
</div>

<!-- MAIN CONTENT -->
<div id="main-wrap">
  <div id="page">

    <!-- USER BALANCE & QUICK TOPUP BAR (ABOVE BANNER) -->
    <div id="home-balance-section" class="home-balance-section">
      <!-- LOGGED IN VIEW -->
      <div id="home-balance-card" class="home-balance-card">
        <div class="hbal-left">
          <div class="hbal-avatar-wrap">
            <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
              document.write('<img id="hbal-avatar" src="' + (window.__EARLY_AVA__ || '/assets/logo.webp') + '" width="38" height="38" alt="Avatar" class="hbal-avatar">');
            </script>
            <span class="hbal-online-dot" title="Online"></span>
          </div>
          <div class="hbal-user-meta">
            <div class="hbal-greeting">
              <span>Halo, </span><b id="hbal-name"><script>document.write(window.__EARLY_NAME__ || 'Member');</script></b>
              <span class="hbal-role-badge" id="hbal-role-badge"><script>document.write(window.__EARLY_ROLE__ || 'Member');</script></span>
            </div>
            <div class="hbal-email" id="hbal-email"><script>document.write(window.__EARLY_EMAIL__ || '');</script></div>
          </div>
        </div>

        <div class="hbal-main-row">
          <div class="hbal-mid">
            <div class="hbal-label-row">
              <span class="hbal-title"><i class="fa-solid fa-wallet" style="color:var(--a);"></i> Saldo Akun Zyro</span>
              <button type="button" class="hbal-icon-btn" id="btn-toggle-balance" onclick="toggleBalanceVisibility()" title="Sembunyikan/Tampilkan Saldo">
                <i class="fa-regular fa-eye" id="icon-toggle-balance"></i>
              </button>
              <button type="button" class="hbal-icon-btn" id="btn-refresh-balance" onclick="refreshUserBalance(true)" title="Perbarui Saldo">
                <i class="fa-solid fa-rotate-right"></i>
              </button>
            </div>
            <div class="hbal-amount-row">
              <span class="hbal-amount" id="hbal-amount-val"><script>document.write(window.__EARLY_BAL_STR__ || 'Rp 0');</script></span>
            </div>
          </div>

          <!-- LIVE STATS MINI WIDGET (USER / TRX COUNTER) -->
          <div class="hbal-stats-box">
            <div class="hbal-stat-item" title="Total Transaksi Sukses">
              <div class="hbal-stat-val" id="total-sukses">
                <span class="tx-pill tx-pill-green">
                  <i class="fa-solid fa-arrow-up-right-dots"></i> <script>
                    var tc = window.currentStoreTotalTrx || parseInt(localStorage.getItem('zyro_total_trx'), 10) || 1179;
                    document.write(Number(tc).toLocaleString('id-ID'));
                  </script>
                </span>
              </div>
              <div class="hbal-stat-lbl">Transaksi</div>
            </div>
            <div class="hbal-stat-divider"></div>
            <div class="hbal-stat-item" title="Total Member Terdaftar">
              <div class="hbal-stat-val" id="total-users">
                <span class="tx-pill tx-pill-blue">
                  <i class="fa-solid fa-users"></i> <script>
                    var uc = window.currentStoreTotalUsers || parseInt(localStorage.getItem('zyro_total_users'), 10) || 592;
                    document.write(Number(uc).toLocaleString('id-ID'));
                  </script>
                </span>
              </div>
              <div class="hbal-stat-lbl">User</div>
            </div>
          </div>
        </div>

        <div class="hbal-right">
          <button type="button" class="btn-hbal-owner-reward" id="btn-owner-reward" style="display:<script>document.write(window.__EARLY_IS_OWNER__ ? 'inline-flex' : 'none');</script>;" onclick="openOwnerRewardModal()" title="Kirim Reward Saldo & Role ke Buyer">
            <i class="fa-solid fa-crown" style="color:#fbbf24;"></i> <span>Reward & Role</span>
          </button>
          <button type="button" class="btn-hbal-topup" onclick="openTopupModal()">
            <i class="fa-solid fa-circle-plus"></i> <span>Isi Saldo (Top Up)</span>
          </button>
          <a href="/profile" class="btn-hbal-sub">
            <i class="fa-solid fa-receipt"></i> <span>Riwayat / Akun</span>
          </a>
        </div>
      </div>

      <!-- LOGGED OUT / GUEST VIEW -->
      <div id="home-guest-balance-card" class="home-guest-balance-card">
        <div class="hguest-left">
          <div class="hguest-icon">
            <i class="fa-solid fa-wallet"></i>
          </div>
          <div class="hguest-text">
            <div class="hguest-title">
              <span>Saldo Akun &amp; Pembayaran Cepat</span>
              <span class="hguest-tag"><i class="fa-solid fa-bolt"></i> Diskon 5% Member</span>
            </div>
            <div class="hguest-desc">
              Masuk atau daftar sekarang untuk menikmati kemudahan bayar pakai Saldo Akun tanpa repot scan QRIS berkali-kali!
            </div>
          </div>
        </div>

        <!-- NEW TRUST & BENEFIT PILLS FOR BALANCED DESKTOP VIEW -->
        <div class="hguest-center-perks">
          <div class="hguest-perk"><i class="fa-solid fa-bolt" style="color:#0ea5e9;"></i> <span>Proses Instan 24/7</span></div>
          <div class="hguest-perk"><i class="fa-solid fa-shield-halved" style="color:#10b981;"></i> <span>Garansi Anti-Suspend</span></div>
          <div class="hguest-perk"><i class="fa-solid fa-qrcode" style="color:#f59e0b;"></i> <span>QRIS 0% Biaya</span></div>
        </div>

        <div class="hguest-right">
          <button type="button" class="btn-hguest-login" onclick="openAuthModal('login')">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> <span>Masuk</span>
          </button>
          <button type="button" class="btn-hguest-reg" onclick="openAuthModal('register')">
            <i class="fa-solid fa-user-plus"></i> <span>Daftar Akun</span>
          </button>
        </div>
      </div>
    </div>

    <!-- SYNCHRONOUS EARLY AUTH HYDRATION (ZERO FOUS) -->
    <script>
      (function() {
        try {
          var u = window.__EARLY_USER__;
          if (!u) return;
          var nameEl = document.getElementById('hbal-name');
          var emailEl = document.getElementById('hbal-email');
          var badgeEl = document.getElementById('hbal-role-badge');
          var balEl = document.getElementById('hbal-amount-val');
          var avatarEl = document.getElementById('hbal-avatar');
          var navName = document.getElementById('userNavName');
          var navAvatar = document.getElementById('userNavAvatar');
          var udName = document.getElementById('udName');
          var udEmail = document.getElementById('udEmail');
          var udAvatar = document.getElementById('udAvatar');
          var btnOwner = document.getElementById('btn-owner-reward');

          var fullName = u.name || u.fullName || (u.email ? u.email.split('@')[0] : 'Member');
          var firstName = fullName.split(' ')[0] || 'Member';
          var isOwner = Boolean(u && (
            (u.email && ['gilangx288@gmail.com', 'zyrodevv@gmail.com', 'gilram336@gmail.com'].includes(u.email.toLowerCase())) ||
            (u.isAdmin === true && u.cpanelRole?.category === 'owner')
          ));

          if (nameEl) nameEl.textContent = firstName;
          if (emailEl) emailEl.textContent = u.email || '';
          if (navName) navName.textContent = firstName;
          if (udName) udName.textContent = fullName;
          if (udEmail) udEmail.textContent = u.email || '';

          if (badgeEl) {
            var roleTitle = (u.cpanelRole?.name || u.role || 'Member').replace('Legal ', '');
            if (Array.isArray(u.roles)) {
              if (u.roles.includes('bug_hunter')) {
                roleTitle = '<i class="fa-solid fa-bug"></i> Bug Hunter';
              } else if (u.roles.includes('top_leaderboard')) {
                roleTitle = '<i class="fa-solid fa-trophy"></i> Top Leaderboard';
              } else if (isOwner || u.roles.includes('developer') || u.roles.includes('founder')) {
                roleTitle = '<i class="fa-solid fa-crown"></i> Founder / Dev';
              }
            } else if (isOwner) {
              roleTitle = '<i class="fa-solid fa-crown"></i> Owner / Dev';
            }
            badgeEl.innerHTML = roleTitle;
          }

          if (balEl && typeof u.balance !== 'undefined') {
            var isHidden = localStorage.getItem('zyro_hide_balance') === 'true' || localStorage.getItem('zyro_balance_hidden') === 'true';
            var strVal = isHidden ? 'Rp ••••••••' : ('Rp ' + Number(u.balance || 0).toLocaleString('id-ID'));
            balEl.textContent = strVal;
            balEl.classList.remove('hbal-amount-long', 'hbal-amount-huge');
            if (!isHidden) {
              if (strVal.length > 15) {
                balEl.classList.add('hbal-amount-huge');
                document.documentElement.classList.add('zyro-bal-huge');
                document.documentElement.classList.remove('zyro-bal-long');
              } else if (strVal.length > 12) {
                balEl.classList.add('hbal-amount-long');
                document.documentElement.classList.add('zyro-bal-long');
                document.documentElement.classList.remove('zyro-bal-huge');
              } else {
                document.documentElement.classList.remove('zyro-bal-long', 'zyro-bal-huge');
              }
            } else {
              document.documentElement.classList.remove('zyro-bal-long', 'zyro-bal-huge');
            }
            var iconEye = document.getElementById('icon-toggle-balance');
            if (iconEye) {
              iconEye.className = isHidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            }
          }

          if (btnOwner && isOwner) {
            btnOwner.style.display = 'inline-flex';
          }

          var sbAdmin = document.getElementById('sbAdminGroup');
          var ftAdmin = document.getElementById('ftAdminLink');
          var udAdmin = document.getElementById('udAdminLink');
          if (sbAdmin && isOwner) sbAdmin.style.display = 'block';
          if (ftAdmin && isOwner) ftAdmin.style.display = 'flex';
          if (udAdmin && isOwner) udAdmin.style.display = 'flex';

          var cachedAva = localStorage.getItem('zyro_cached_avatar_b64');
          var effectiveAvatar = cachedAva || u.avatar || '/assets/logo.webp';
          if (avatarEl) avatarEl.src = effectiveAvatar;
          if (navAvatar) navAvatar.src = effectiveAvatar;
          if (udAvatar) udAvatar.src = effectiveAvatar;
        } catch(e) {}
      })();
    </script>

