<!-- FLOATING LIVE CHAT CS (AI FIRST + HUMAN ADMIN TAKEOVER) -->
<button id="floating-chat-btn" onclick="toggleChatWidget()" title="Live Chat CS (AI 24 Jam)">
  <i class="fa-solid fa-comments"></i>
  <span class="chat-btn-pulse"></span>
  <span class="chat-badge-dot"></span>
</button>

<div id="chat-widget-box">
  <div class="chat-head">
    <div class="chat-head-info">
      <div class="chat-head-avatar"><i class="fa-solid fa-headset"></i></div>
      <div>
        <div class="chat-head-name">ZyroStore Support</div>
        <div class="chat-head-sub">
          <span class="chat-head-dot"></span> Online • CS 24 Jam Siap Membantu
        </div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:6px;">
      <button class="chat-head-btn" id="btnRefreshChat" onclick="refreshChatMessages()" title="Segarkan Percakapan (Tanpa Hapus Riwayat)">
        <i class="fa-solid fa-arrows-rotate" id="iconRefreshChat"></i>
      </button>
      <button class="chat-head-btn" onclick="toggleChatWidget()" title="Tutup Chat">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>
  <div class="chat-body" id="chat-messages">
    <div class="chat-bubble-wrap ai">
      <span class="chat-sender-lbl"><i class="fa-solid fa-wand-magic-sparkles" style="color:var(--a);"></i> Zyro AI CS</span>
      <div class="chat-bubble ai">
        Halo! Selamat datang di <b>ZyroStore.id</b>.<br>
        Ada yang bisa kami bantu? Tanyakan tentang stok panel, cara order, spek RAM/Disk add-on, atau klaim garansi.
      </div>
      <span class="chat-bubble-time">Sekarang</span>
    </div>
  </div>
  <div class="chat-chips-wrap">
    <button class="chat-chip" onclick="quickChat('Bisa tambah spek RAM dan CPU panel?')"><i class="fa-solid fa-bolt"></i> Add-on Spek Panel</button>
    <button class="chat-chip" onclick="quickChat('Bagaimana cara klaim garansi panel?')"><i class="fa-solid fa-shield-halved"></i> Klaim Garansi</button>
    <button class="chat-chip" onclick="quickChat('Metode pembayaran apa saja yang tersedia?')"><i class="fa-solid fa-credit-card"></i> Metode Bayar</button>
    <button class="chat-chip" onclick="quickChat('Berapa lama proses pembuatan panel?')"><i class="fa-solid fa-stopwatch"></i> Waktu Proses</button>
  </div>
  <form class="chat-input-bar" onsubmit="handleSendChatMessage(event)">
    <input type="text" id="chatInputText" class="chat-input" placeholder="Tulis pertanyaanmu..." autocomplete="off">
    <button type="submit" class="chat-send-btn" id="chatSendBtn" title="Kirim">
      <i class="fa-solid fa-paper-plane"></i>
    </button>
  </form>
</div>

